# Run with: node --env-file=.env server.mjs
GATEWAY_MODE=demo
APP_ORIGIN=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173
# Live requires HTTPS APP_ORIGIN, HOST=0.0.0.0 on Railway, and an approved directory.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RATE_LIMIT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Add after creating a webhook at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
ROUTING_POLICY_APPROVED=false
# Optional self-hosted OpenAI-compatible endpoint; these are not OpenAI credentials.
# AI_BASE_URL=http://127.0.0.1:11434
# AI_PROTOCOL=ollama
# AI_MODEL=gemma4:26b
# AI_PROCESSOR_NOTICE=Self-hosted model operated by the student union; no prompt logging.
AI_TIMEOUT_MS=8000

# Web service includes the background sender by default.
BACKGROUND_WORKER=true
# Railway: allow in-flight work to finish during a deploy.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=35
# Used only by local operator commands; no public admin interface.
OPERATOR_NAME=
