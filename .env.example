# Run with: node --env-file=.env server.mjs
GATEWAY_MODE=demo
APP_ORIGIN=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173
# Live requires HTTPS APP_ORIGIN, HOST=0.0.0.0 on Railway, and an approved directory.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
ROUTING_POLICY_APPROVED=false
# Optional self-hosted OpenAI-compatible endpoint; these are not OpenAI credentials.
# AI_BASE_URL=http://127.0.0.1:11434
# AI_PROTOCOL=ollama
# AI_MODEL=gemma4:26b
